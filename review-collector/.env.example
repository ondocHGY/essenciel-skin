# ===========================
# Review Collector 설정
# ===========================

# QSM (Qoo10 판매자 관리) 설정
QSM_ID=your_qsm_id
QSM_PASSWORD=your_qsm_password

# 데이터베이스 설정 (Laravel과 동일한 DB)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=qrcode
DB_USER=root
DB_PASSWORD=your_db_password

# Chrome 설정
CHROME_HEADLESS=true
CHROME_VERSION=144

# 스케줄러 설정
SYNC_ENABLED=true
SYNC_HOUR=3
SYNC_MINUTE=0

# 로깅
LOG_LEVEL=INFO
